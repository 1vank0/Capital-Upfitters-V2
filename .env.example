# ── Database (Neon PostgreSQL) ─────────────────────────────
# Use the POOLED connection string from Neon dashboard.
# The pooled hostname contains "-pooler" (e.g. ep-xxx-pooler.us-east-2.aws.neon.tech)
# Both DATABASE_URL and DATABASE_URI are supported (DATABASE_URL takes priority).
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-2.aws.neon.tech/capital_upfitters?sslmode=require

# ── Payload ────────────────────────────────────────────────
PAYLOAD_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# ── Frontend CORS ──────────────────────────────────────────
# Set to your frontend domain in production. Leave blank for * (dev only).
FRONTEND_URL=

# ── Storage (choose ONE — leave all blank for local disk) ──
# Option A: Vercel Blob
BLOB_READ_WRITE_TOKEN=

# Option B: S3-compatible (AWS, Cloudflare R2, MinIO)
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=us-east-1
S3_ENDPOINT=

# ── Site Protection (Basic Auth) ──────────────────────────
# Set SITE_PROTECTION=true to lock the entire site behind a password.
# Browser will prompt: username "admin", password = SITE_PASSWORD value.
# Remove or set to false when ready to go live.
SITE_PROTECTION=false
SITE_PASSWORD=

# ── Node ───────────────────────────────────────────────────
NODE_ENV=development
